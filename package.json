    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.0.0",
    "element-plus": "^2.5.0",
    "@element-plus/icons-vue": "^2.3.0",
    "@uppy/core": "^3.13.0",
    "@uppy/dashboard": "^3.8.0",
    "@uppy/tus": "^3.5.0",
    "@uppy/locales": "^3.5.0",
    "tus-js-client": "^3.1.0",
    "pdfjs-dist": "^4.0.0",
    "vue3-pdf": "^4.2.6",
    "codemirror": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-xml": "^6.0.0",
    "jszip": "^3.10.0",
    "three": "^0.160.0",
    "vuedraggable": "^4.1.0",
