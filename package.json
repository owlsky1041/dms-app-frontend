{
  "name": "dms-frontend",
  "version": "1.0.0",
  "description": "DMS 文档管理系统前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
